// Tang Primer 25K / GW5A-LV25MG121NC1/I0 — I2S LPF project.
// Input  (slave, from transport): mclk C11, bclk C10, lrck D11, sdata B11.
// Output (master, MCLK-derived) : bclk E11, lrck A11, sdata K11.
// Clock-capable: C11 GCLKT_13, C10 GCLKC_13, E11 GCLKT_14.

IO_LOC "mclk_in" C11;
IO_PORT "mclk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "i2s_bclk_in" C10;
IO_PORT "i2s_bclk_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "i2s_lrck_in" D11;
IO_PORT "i2s_lrck_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// Pull-down: a stopped/floating transport reads as zeros, not garbage.
IO_LOC "i2s_sdata_in" B11;
IO_PORT "i2s_sdata_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "i2s_bclk_out" E11;
IO_PORT "i2s_bclk_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_lrck_out" A11;
IO_PORT "i2s_lrck_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "i2s_sdata_out" K11;
IO_PORT "i2s_sdata_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

// Native-DSD enable from the transport (Amanero-style DSD-on). Pull-down:
// PCM mode when the transport does not drive the line. In DSD mode the
// transport drives the DSD bit clock on BCLK (C10), DATA1 on SDATA (B11)
// and DATA2 on LRCLK (D11); DSD64..512 require MCLK 45.1584 MHz.
IO_LOC "dsd_on" G11;
IO_PORT "dsd_on" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// Dedicated DSD DATA2 input (second transport type). Pull-down: with an
// Amanero-style transport the pin floats, and the detector must see a
// quiet line (it selects the alt source on >= 16 bit-boundary toggles
// in the ~1 ms acquisition window). The active transport overrides it.
IO_LOC "dsd_data2_in" G10;
IO_PORT "dsd_data2_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "nos_bypass" A10;
IO_PORT "nos_bypass" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// TDA1541(A) simultaneous-mode output on the right pin group.
// BCK goes to the clock-capable pin H5 (GCLKT_2); LE/DL/DR are plain I/O.
IO_LOC "tda_bck_out" H5;
IO_PORT "tda_bck_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "tda_le_out" F5;
IO_PORT "tda_le_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "tda_dl_out" G7;
IO_PORT "tda_dl_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "tda_dr_out" H8;
IO_PORT "tda_dr_out" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
